{
  "$schema": "https://ui.chrisgarlick.com/schema/section/1.json",
  "name": "pricing",
  "title": "Pricing",
  "version": 1,
  "category": "kit-sections",
  "description": "A heading and up to four price cards side by side: a name, the price, who it's for, what's included and a button. One can be highlighted.",
  "variants": {
    "default": "Heading on the left, link at the end of the row",
    "centred": "Heading centred"
  },
  "fields": {
    "eyebrow": {
      "type": "text",
      "label": "Label above the heading",
      "max": 60
    },
    "title": {
      "type": "rich-text",
      "label": "Heading",
      "help": "*Words in stars* are set in italics.",
      "required": true,
      "max": 120
    },
    "heading_level": {
      "type": "heading-level",
      "label": "Heading level",
      "default": 2
    },
    "lede": {
      "type": "rich-text",
      "label": "Line under the heading",
      "help": "One line, like \"What's included and what isn't, before anyone books.\"",
      "max": 200
    },
    "link_label": {
      "type": "text",
      "label": "Link",
      "help": "A link at the end of the heading row, like \"All services\".",
      "max": 40
    },
    "link_url": {
      "type": "url",
      "label": "Link address"
    },
    "plans": {
      "type": "list",
      "label": "Prices",
      "max": 4,
      "item": {
        "name": {
          "type": "text",
          "label": "Name",
          "required": true,
          "max": 40
        },
        "price": {
          "type": "text",
          "label": "Price",
          "help": "As it should read: \"£79\", \"From £49\".",
          "required": true,
          "max": 20
        },
        "per": {
          "type": "text",
          "label": "Per",
          "help": "\"per visit\", \"a month\".",
          "max": 30
        },
        "description": {
          "type": "text",
          "label": "Who it's for",
          "max": 120
        },
        "features": {
          "type": "list",
          "label": "What's included",
          "max": 10,
          "item": {
            "text": {
              "type": "text",
              "label": "Included",
              "required": true,
              "max": 80
            }
          }
        },
        "featured": {
          "type": "boolean",
          "label": "Highlight this one"
        },
        "badge": {
          "type": "text",
          "label": "Badge",
          "help": "On a highlighted price, like \"Most popular\".",
          "max": 24
        },
        "action_label": {
          "type": "text",
          "label": "Button",
          "max": 30
        },
        "action_url": {
          "type": "url",
          "label": "Button link"
        }
      }
    },
    "background": {
      "type": "enum",
      "label": "Background",
      "options": [
        "plain",
        "tinted"
      ],
      "default": "plain"
    }
  }
}
