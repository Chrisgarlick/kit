{
  "$schema": "https://ui.chrisgarlick.com/schema/section/1.json",
  "name": "gallery",
  "title": "Gallery",
  "version": 1,
  "category": "kit-sections",
  "description": "A heading and a grid of photos of the work, each with an optional caption.",
  "variants": {
    "default": "Heading on the left, link at the end of the row",
    "centred": "Heading centred"
  },
  "fields": {
    "eyebrow": {
      "type": "text",
      "label": "Label above the heading",
      "max": 60
    },
    "title": {
      "type": "rich-text",
      "label": "Heading",
      "help": "*Words in stars* are set in italics.",
      "required": true,
      "max": 120
    },
    "heading_level": {
      "type": "heading-level",
      "label": "Heading level",
      "default": 2
    },
    "lede": {
      "type": "rich-text",
      "label": "Line under the heading",
      "help": "One line of introduction, if the section needs it.",
      "max": 200
    },
    "link_label": {
      "type": "text",
      "label": "Link",
      "help": "A link at the end of the heading row, like \"All services\".",
      "max": 40
    },
    "link_url": {
      "type": "url",
      "label": "Link address"
    },
    "columns": {
      "type": "enum",
      "label": "Columns",
      "help": "The most cards in a row; fewer fit on a narrow screen.",
      "options": [
        "2",
        "3",
        "4"
      ],
      "default": "3"
    },
    "images": {
      "type": "list",
      "label": "Photos",
      "max": 24,
      "item": {
        "image": {
          "type": "image",
          "label": "Photo",
          "alt": "required",
          "sizes": "card"
        },
        "caption": {
          "type": "text",
          "label": "Caption",
          "max": 120
        }
      }
    },
    "background": {
      "type": "enum",
      "label": "Background",
      "options": [
        "plain",
        "tinted"
      ],
      "default": "plain"
    }
  }
}
