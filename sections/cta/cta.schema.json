{
  "$schema": "https://ui.chrisgarlick.com/schema/section/1.json",
  "name": "cta",
  "title": "Call to action",
  "version": 1,
  "category": "kit-sections",
  "description": "A band in the accent colour: one line that asks, one that reassures, a button and a phone number.",
  "fields": {
    "eyebrow": { "type": "text", "label": "Label above the heading", "help": "A short kicker, like \"Next step\".", "max": 60 },
    "title": { "type": "rich-text", "label": "Heading", "required": true, "max": 120 },
    "heading_level": { "type": "heading-level", "label": "Heading level", "default": 2 },
    "lede": { "type": "text", "label": "Supporting line", "max": 160 },
    "action_label": { "type": "text", "label": "Button", "max": 30 },
    "action_url": { "type": "url", "label": "Button link" },
    "secondary_label": { "type": "text", "label": "Text link", "help": "A second, quieter action beside the button, like \"See how it works\". Shown with an arrow.", "max": 40 },
    "secondary_url": { "type": "url", "label": "Text link address" },
    "phone": { "type": "text", "label": "Phone number", "max": 30, "bind": "site.phone" }
  }
}
